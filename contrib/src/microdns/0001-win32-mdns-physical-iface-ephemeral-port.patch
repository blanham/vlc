 static bool
+mdns_is_virtual_adapter(IP_ADAPTER_ADDRESSES *intf)
+{
+    static const wchar_t *const needles[] = {
+        L"VMware", L"Hyper-V", L"VirtualBox", L"vEthernet",
+        L"Wintun", L"TAP-", L"Bluetooth",
+        NULL
+    };
+    const wchar_t *desc = intf->Description ? intf->Description : L"";
+    const wchar_t *name = intf->FriendlyName ? intf->FriendlyName : L"";
+    for (size_t i = 0; needles[i] != NULL; ++i) {
+        if (wcsstr(desc, needles[i]) != NULL || wcsstr(name, needles[i]) != NULL)
+            return true;
+    }
+    return false;
+}
+
+static bool
 mdns_is_interface_valuable(IP_ADAPTER_ADDRESSES *intf)
 {
-    return (intf->IfType == IF_TYPE_IEEE80211 || intf->IfType == IF_TYPE_ETHERNET_CSMACD) &&
-            intf->OperStatus == IfOperStatusUp;
+    if (intf->OperStatus != IfOperStatusUp)
+        return false;
+    if (intf->IfType != IF_TYPE_IEEE80211 && intf->IfType != IF_TYPE_ETHERNET_CSMACD)
+        return false;
+    /* Multi-homed Windows PCs often have VMware/Hyper-V NICs that steal
+     * mDNS when every ethernet-class adapter joins 224.0.0.251:5353. Prefer
+     * physical LAN/Wi-Fi only. */
+    if (mdns_is_virtual_adapter(intf))
+        return false;
+    return true;
 }
 
